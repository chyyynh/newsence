{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsence-search-repair-251",
	"main": "src/search-terminal-repair-251-entry.ts",
	"workers_dev": false,
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"limits": {
		"subrequests": 1000000
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	},
	"workflows": [
		{
			"binding": "SEARCH_INDEX_TERMINAL_REPAIR_251_FAILED_WORKFLOW",
			"name": "newsence-search-index-terminal-repair-251",
			"class_name": "SearchIndexTerminalRepair251Workflow"
		},
		{
			"binding": "SEARCH_INDEX_TERMINAL_REPAIR_251_WORKFLOW",
			"name": "newsence-search-index-terminal-repair-251-v2",
			"class_name": "SearchIndexTerminalRepair251Workflow"
		}
	],
	"services": [
		{
			"binding": "PHASE1_SEARCH_REBUILD_SOURCE_CORE",
			"service": "newsence-core"
		}
	],
	"ai_search": [
		{
			"binding": "AI_SEARCH",
			"instance_name": "newsence-corpus-v6",
			"remote": true
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "5d7b16cf287e4dcc8b36d43461ccbf5c"
		}
	],
	"placement": {
		"mode": "smart"
	}
}
