{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsence-search-stuck-item-recovery-251-v2",
	"main": "src/search-stuck-item-recovery-251-entry.ts",
	"workers_dev": false,
	"routes": [],
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"limits": {
		"subrequests": 1000000
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	},
	"workflows": [
		{
			"binding": "SEARCH_INDEX_STUCK_ITEM_RECOVERY_251_WORKFLOW",
			"name": "newsence-search-index-stuck-item-recovery-251-v2",
			"class_name": "SearchIndexStuckItem251RecoveryWorkflow"
		}
	],
	"ai_search": [
		{
			"binding": "AI_SEARCH",
			"instance_name": "newsence-corpus-v6",
			"remote": true
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "5d7b16cf287e4dcc8b36d43461ccbf5c"
		}
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"placement": {
		"mode": "smart"
	}
}
