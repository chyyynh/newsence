/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsence-core",
	"main": "src/index.ts",
	"workers_dev": false,
	"compatibility_date": "2026-07-22",
	/**
	 * Keep request abort signals available to fetch-heavy ingest endpoints and
	 * propagate them into subrequests.
	 */
	"compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
	/**
	 * A full AI Search rebuild performs one upload subrequest per corpus item.
	 * Keep enough headroom for the 500k-file hybrid-search instance limit.
	 */
	"limits": {
		"subrequests": 1000000
	},
	/**
	 * Bundle `.wasm` files as compiled `WebAssembly.Module` imports. Used by the
	 * PDF text-extraction stage (`@llamaindex/liteparse-wasm`) in
	 * `src/ingest/platforms/pdf.ts`. `fallthrough` keeps default rules for any
	 * other module types.
	 */
	"rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 0.05
		}
	},
	/**
	 * Schedule Triggers
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 */
	"triggers": {
		"crons": [
			"*/5 * * * *", // RSS monitor, incl. YouTube channel feeds (every 5 minutes)
			"0 */6 * * *" // Twitter monitor (every 6 hours)
		]
	},
	/**
	 * Workflows
	 * https://developers.cloudflare.com/workflows/
	 */
	"workflows": [
		{
			"binding": "RESOURCE_PROCESSING_V2_WORKFLOW",
			"name": "newsence-resource-processing-v2",
			"class_name": "ResourceProcessingV2Workflow"
		},
		{
			"binding": "RESOURCE_TRANSLATION_V2_WORKFLOW",
			"name": "newsence-resource-translation-v2",
			"class_name": "ResourceTranslationV2Workflow"
		},
		{
			"binding": "SEARCH_INDEX_GENERATION_5_REBUILD_WORKFLOW",
			"name": "newsence-search-index-generation-5-rebuild",
			"class_name": "SearchIndexGeneration5RebuildWorkflow"
		},
		{
			"binding": "RECENT_RESOURCE_IMAGE_BACKFILL_V2_WORKFLOW",
			"name": "newsence-recent-resource-image-backfill-v2",
			"class_name": "RecentResourceImageBackfillV2Workflow"
		},
		{
			"binding": "ACADEMIC_METADATA_BACKFILL_V3_WORKFLOW",
			"name": "newsence-academic-metadata-backfill-v3",
			"class_name": "AcademicMetadataBackfillV3Workflow"
		}
	],
	/**
	 * Workers AI Binding
	 * https://developers.cloudflare.com/workers-ai/get-started/workers-wrangler/
	 */
	"ai": {
		"binding": "AI"
	},
	"ai_search": [
		{
			"binding": "AI_SEARCH",
			"instance_name": "newsence-corpus-v6",
			"remote": true
		}
	],
	/**
	 * Hyperdrive — PlanetScale PostgreSQL connection pooling
	 * https://developers.cloudflare.com/hyperdrive/
	 */
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "5d7b16cf287e4dcc8b36d43461ccbf5c"
		}
	],
	/**
	 * R2 buckets.
	 *
	 * `R2` — uploaded PDF storage used for text extraction.
	 *   Also written by the app worker; the core worker reads
	 *   uploaded PDFs here for LiteParse WASM text extraction.
	 */
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "newsence"
		}
	],
	"services": [
		{
			"binding": "DOMAIN",
			"service": "newsence-web-tanstack",
			"entrypoint": "DomainRpc"
		}
	],
	/**
	 * Smart Placement — run close to database
	 */
	"placement": {
		"mode": "smart"
	},
	/**
	 * `AI_GATEWAY_NAME` — dedicated AI Gateway for system ingest inference.
	 *   Create non-default gateways in Cloudflare before deploying.
	 * `AI_GATEWAY_ENVIRONMENT` — trusted deployment label attached to Gateway logs.
	 *
	 * Required secrets:
	 * - KAITO_API_KEY enables Twitter ingestion enrichment.
	 * - YOUTUBE_API_KEY enables YouTube transcript/channel enrichment.
	 * - S2_API_KEY increases Semantic Scholar quota for paper enrichment.
	 */
	"secrets": {
		"required": ["KAITO_API_KEY", "YOUTUBE_API_KEY", "S2_API_KEY"]
	},
	"vars": {
		"AI_GATEWAY_NAME": "core-ingest",
		// Local scripts override this trusted label to `development`.
		"AI_GATEWAY_ENVIRONMENT": "production"
	}
}
