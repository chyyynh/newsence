{
	"name": "newsence-core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:dry-run": "pnpm run typecheck && wrangler deploy --dry-run",
		"check:db-schema": "node scripts/check-drizzle-prisma-drift.mjs",
		"check:startup": "wrangler check startup",
		"dev": "wrangler dev --test-scheduled",
		"start": "wrangler dev --test-scheduled",
		"cf-typegen": "wrangler types --env-interface CoreEnv",
		"typecheck": "pnpm cf-typegen && pnpm check:db-schema && tsc --noEmit",
		"typecheck:types": "wrangler types --check --env-interface CoreEnv",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@extractus/feed-extractor": "^7.2.1",
		"@llamaindex/liteparse-wasm": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.20.0",
		"youtube-caption-extractor": "1.10.2",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@cloudflare/workers-types": "^4.20260131.0",
		"@types/node": "^22.19.7",
		"@types/pg": "^8.18.0",
		"typescript": "^5.9.3",
		"wrangler": "^4.107.0"
	}
}
