{
	"name": "newsence-core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:dry-run": "pnpm run typecheck && wrangler deploy --dry-run",
		"check:startup": "wrangler check startup",
		"dev": "wrangler dev --test-scheduled",
		"start": "wrangler dev --test-scheduled",
		"cf-typegen": "wrangler types",
		"typecheck": "wrangler types && tsc --noEmit",
		"typecheck:types": "wrangler types --check",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@bufbuild/protobuf": "^1.10.0",
		"@extractus/feed-extractor": "^7.2.1",
		"@llamaindex/liteparse-wasm": "^2.1.1",
		"@mozilla/readability": "^0.6.0",
		"cheerio": "^1.2.0",
		"hpack": "^1.0.0",
		"linkedom": "^0.18.12",
		"node-forge": "^1.4.0",
		"pg": "^8.20.0",
		"turndown": "^7.2.2",
		"youtube-caption-extractor": "1.10.2",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@cloudflare/workers-types": "^4.20260131.0",
		"@types/node": "^22.19.7",
		"@types/node-forge": "^1.3.14",
		"@types/pg": "^8.18.0",
		"@types/turndown": "^5.0.6",
		"typescript": "^5.9.3",
		"wrangler": "^4.107.0"
	}
}
