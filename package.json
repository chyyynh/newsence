{
	"name": "newsence-core",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:dry-run": "pnpm run typecheck && wrangler deploy --dry-run",
		"check:db-schema": "node scripts/check-drizzle-prisma-drift.mjs",
		"check:resource-identity": "node --experimental-strip-types scripts/check-resource-identity.mjs",
		"check:startup": "wrangler check startup",
		"dev": "wrangler dev --test-scheduled --var AI_GATEWAY_ENVIRONMENT:development",
		"start": "wrangler dev --test-scheduled --var AI_GATEWAY_ENVIRONMENT:development",
		"cf-typegen": "wrangler types --env-interface BaseCoreEnv",
		"typecheck": "pnpm cf-typegen && pnpm check:db-schema && pnpm check:resource-identity && tsc --noEmit",
		"typecheck:types": "wrangler types --check --env-interface BaseCoreEnv",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@extractus/article-extractor": "^8.1.0",
		"@llamaindex/liteparse-wasm": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"feedsmith": "2.9.6",
		"html-entities": "^2.6.0",
		"pg": "^8.22.0",
		"youtube-transcript": "1.3.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^22.19.7",
		"@types/pg": "^8.20.0",
		"typescript": "^5.9.3",
		"wrangler": "^4.120.0"
	}
}
